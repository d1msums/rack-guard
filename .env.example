# Copy to .env then run python setup_dashboard.py. Never commit the actual .env.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD_HASH=
RACKGUARD_ANALYSIS_FILE=~/.local/state/coldguard/analysis.json
# Optional: exact locally installed Ollama model name for analysis_worker.py
OLLAMA_MODEL=
# COLDGUARD_CONFIG=/home/delta/RackGuard-Dashboard-v6/config.json

# VM only; configure privately with setup_gemini.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
